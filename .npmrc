public-hoist-pattern[]=*babel*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=metro*

# Acorta los nombres del virtual store (default 120). En Windows las rutas que
# generan CMake/ninja para el build nativo de Android superaban MAX_PATH (260)
# y el build fallaba con "build.ninja still dirty" / "Filename longer than 260
# characters".
#
# Es la alternativa PORTABLE a `virtual-store-dir=C:/ps`: acorta lo mismo sin
# sacar el store del arbol del repo, asi que no rompe en Mac/Linux ni entra en
# conflicto con los public-hoist-pattern de arriba (lo elevado aterriza en el
# node_modules del repo, que es invisible desde un store fuera del arbol).
#
# 20 y no 40: la ruta mas larga que genera el build es la fuente que el codegen
# de RN escribe dentro del store,
#
#   <store>/@react-_<hash>/node_modules/@react-native-google-signin/google-signin
#   /android/build/generated/source/codegen/jni/react/renderer/components
#   /RNGoogleSignInCGen/RNGoogleSignInCGenJSI-generated.cpp
#
# que con 40 mide 265 y no cabe. Cada caracter que se recorte aqui se descuenta
# de ella. Esa ruta la compone `ReactNative-application.cmake` a partir del
# directorio del modulo, asi que NO se puede reubicar desde Gradle; esta es la
# unica palanca que la acorta. La otra mitad del problema —el `.cxx`, que si es
# reubicable— la resuelve el config plugin `withShortNativeBuildDir.js` de cada
# app moviendo esos directorios a una raiz corta.
#
# Por debajo de ~33 ya no baja: pnpm siempre deja el hash de 32 chars, asi que
# 20 y 33 dan el mismo nombre. Con eso la ruta de arriba queda en 258, uno por
# debajo del limite, lo que no es margen suficiente para vivir tranquilo.
virtual-store-dir-max-length=20

# Los 16 chars que faltaban. `virtual-store-dir` admite ruta relativa (se
# resuelve contra la raiz del workspace), asi que acortar `node_modules/.pnpm` a
# `.p` es portable: el store sigue dentro del arbol del repo y se comporta igual
# en Mac y Linux, al reves que el `virtual-store-dir=C:/ps` absoluto que se uso
# antes. La ruta critica pasa de 258 a 242.
virtual-store-dir=.p
