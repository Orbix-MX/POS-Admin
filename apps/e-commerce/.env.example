# Base URL of apps/api (no trailing slash, no /api suffix — it's added by the client scripts)
# Same value for every tenant deployment — the storefront no longer needs a
# tenantId: the API resolves the tenant from this site's own Origin header
# via the `Domain` table (see api: platform/tenants/:tenantId/domains).
# Register this site's domain there before the storefront can load any data.
PUBLIC_API_URL=http://localhost:3001

# Tenant slug used by /admin to log in — must match a real tenant in apps/api.
# The panel only lets in users with a membership in THIS tenant, even if their
# ERP account also belongs to others.
PUBLIC_TENANT_SLUG=manzanitas
