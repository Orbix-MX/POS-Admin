# Loaded automatically by Expo when NODE_ENV=production (EAS builds, `expo export`).
# Client IDs are injected by the CI/EAS environment — do not commit real values.
EXPO_PUBLIC_API_URL=https://api.orbix.app/api
EXPO_PUBLIC_API_TIMEOUT=15000
EXPO_PUBLIC_DEFAULT_LOCALE=es

EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
