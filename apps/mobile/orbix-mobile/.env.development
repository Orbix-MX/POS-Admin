# Loaded automatically by Expo when NODE_ENV=development (the default for
# `expo start`). Values here are committed — keep secrets out.
EXPO_PUBLIC_API_URL=http://192.168.3.62:3002/api
EXPO_PUBLIC_API_TIMEOUT=20000
EXPO_PUBLIC_DEFAULT_LOCALE=es

# Filled in per-developer via `.env` (git-ignored).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
