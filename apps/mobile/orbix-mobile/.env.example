# Copy to `.env` (local overrides, git-ignored). Expo inlines every EXPO_PUBLIC_*
# variable into the JS bundle at build time — never put a secret here.

# Base URL of the Orbix NestJS API, including the `/api` global prefix.
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT=15000

# Google OAuth client IDs (expo-auth-session). Leave empty to disable the
# "Continue with Google" button — the app degrades gracefully.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Default language when the device locale is not supported (es | en | pt).
EXPO_PUBLIC_DEFAULT_LOCALE=es
