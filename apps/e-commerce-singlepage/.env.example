# Base URL of apps/api (no trailing slash, no /api suffix — it's added by the client scripts)
# Same value for every tenant deployment — el navegador resuelve el tenant a
# partir del Origin de esta página vía la tabla Domain, este template nunca
# necesita saber su propio tenantId.
PUBLIC_API_URL=http://localhost:3001

# Canonical/OG base URL para ESTE deployment (build-time, cosmético).
PUBLIC_SITE_URL=https://your-tenant-domain.example
