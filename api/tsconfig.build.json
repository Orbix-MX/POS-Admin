{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Dentro de dist a propósito: `nest-cli.json` usa deleteOutDir, y con el
    // buildinfo fuera de dist tsc lo daba por vigente, no emitía nada y `nest
    // start` moría con "Cannot find module dist/main".
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma.config.ts", "prisma/**", "scripts/**"]
}
