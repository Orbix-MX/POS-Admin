{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Sin esto tsc infiere rootDir = api/ (por prisma.config.ts y prisma/seed.ts)
    // y emite a dist/src/main.js, rompiendo `start:prod` → node dist/main.
    "rootDir": "./src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "prisma", "prisma.config.ts"]
}
