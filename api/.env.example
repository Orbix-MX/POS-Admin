# Plantilla de configuración de @orbix/api.
#
#   cp .env.example .env
#
# Solo DATABASE_URL, JWT_SECRET y PLATFORM_JWT_SECRET son obligatorias: sin
# ellas el API no arranca. El resto tiene default o desactiva su función cuando
# falta (Google, correo, almacenamiento, IA).
#
# `.env` está en .gitignore. Nunca pongas valores reales en este archivo.

# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL. En Neon, la cadena "pooled" del panel.
DATABASE_URL=postgresql://usuario:password@host:5432/orbix?sslmode=require

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Orígenes permitidos, separados por comas. "*" abre a cualquiera (solo dev).
# Cualquier otro origen se valida contra la tabla `Domain`, así que una tienda
# nueva no exige redeploy. 5173 = Admin Web, 5174 = POS Web.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Sesión (obligatorias) ────────────────────────────────────────────────────
# Cadenas largas y aleatorias, distintas entre sí. Por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El panel platform firma con su propio secreto a propósito: un token de tenant
# nunca debe valer contra endpoints de super-admin, ni al revés.
JWT_SECRET=
PLATFORM_JWT_SECRET=
# Vida del access token (default 1d).
JWT_EXPIRES_IN=1d
# Vida del refresh token opaco, en días (default 30).
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ── Super-admin inicial ──────────────────────────────────────────────────────
# Solo los usa `prisma db seed` para crear el PlatformUser. Si se dejan vacías,
# el seed omite ese paso.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── PIN de empleados ─────────────────────────────────────────────────────────
# Pepper del hash de PIN (login de comandera y autorización de caja en el POS).
# Cambiarlo invalida TODOS los PIN existentes: hay que volver a asignarlos.
STAFF_PIN_PEPPER=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID →
# Web application. En "Authorized redirect URIs" registra exactamente el valor
# de GOOGLE_CALLBACK_URL (con /api, sin barra final) o Google responde
# redirect_uri_mismatch.
#
# Sin CLIENT_ID/SECRET el API arranca igual y /auth/google responde 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Allowlist de destinos tras el callback. Sin ella el `state` convertiría el
# callback en un open redirect con un ticket de sesión válido adjunto.
OAUTH_ALLOWED_REDIRECTS=http://localhost:5173,http://localhost:5174
# Vida del ticket de un solo uso que el frontend canjea por la sesión (default 120).
OAUTH_TICKET_TTL_SECONDS=120

# ── Google OAuth (app móvil orbix-mobile, PKCE) ──────────────────────────────
# Clientes aparte del de arriba: uno por plataforma en Google Cloud Console
# (tipo "iOS" / "Android" con el bundle id / package name / huella SHA-1 de la
# app; tipo "Web application" para Expo web). Los de iOS/Android no llevan
# secreto (PKCE puro); el de Web sí lo pide Google al canjear el código aunque
# se use PKCE. Sin ninguno configurado, POST /auth/google responde 503 para
# esa plataforma — igual que el flujo de arriba.
GOOGLE_MOBILE_IOS_CLIENT_ID=
GOOGLE_MOBILE_ANDROID_CLIENT_ID=
GOOGLE_MOBILE_WEB_CLIENT_ID=
GOOGLE_MOBILE_WEB_CLIENT_SECRET=

# ── Correo (SMTP) ────────────────────────────────────────────────────────────
# Sin SMTP_HOST no se envían correos; el resto de la app funciona igual.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Almacenamiento de archivos (Cloudflare R2) ───────────────────────────────
# Sin R2_ACCOUNT_ID el servicio queda inactivo y las subidas fallan.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Impresión con QZ Tray ────────────────────────────────────────────────────
# Certificado y llave para firmar las peticiones de impresión. Sin ellos, QZ
# pide confirmación manual en cada impresión.
QZ_CERT_PATH=
QZ_PRIVATE_KEY_PATH=

# ── Datos de la tienda para tickets ──────────────────────────────────────────
STORE_NAME=
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=

# ── IA ───────────────────────────────────────────────────────────────────────
# Proveedor local compatible con la API de OpenAI (Ollama, LM Studio…).
AI_LOCAL_BASE_URL=http://localhost:11434
AI_LOCAL_API_KEY=
# Proveedores en la nube. Sin clave, ese proveedor queda deshabilitado.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Topes de gasto en USD. Al superarlos se corta el uso de proveedores de pago.
AI_BUDGET_DAILY_USD=
AI_BUDGET_MONTHLY_USD=
