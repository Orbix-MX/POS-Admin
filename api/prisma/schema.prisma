generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ============= Tenants =============

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
  EXPIRED
  DISABLED
}

// ============= Platform (SaaS Admin) =============

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
}

enum PlatformUserStatus {
  ACTIVE
  INACTIVE
}

model PlatformUser {
  id        String             @id @default(uuid())
  email     String             @unique
  password  String
  firstName String
  lastName  String
  role      PlatformUserRole   @default(SUPER_ADMIN)
  status    PlatformUserStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  platformUserId String?
  tenantId       String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  notes          String?
  createdAt      DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, action])
  @@index([platformUserId, createdAt])
  @@map("platform_audit_logs")
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  PLUS
  ENTERPRISE
}

enum BusinessVertical {
  RETAIL
  RESTAURANT
  GYM
  SERVICES
}

// Base architecture of the tenant, fixed at provisioning time and NOT editable
// from the ERP. Distinct from BusinessVertical (operational behaviour): the
// profile describes the structural shape the tenant was created with. Pure
// persistence for now — no behaviour is derived from it yet (BP-01).
enum BusinessProfile {
  RETAIL
  RETAIL_MANUFACTURING
  RESTAURANT
  MANUFACTURING
  SERVICES
  WORKSHOP
}

enum PosOperationMode {
  QUICK_SALE
  TABLE_SERVICE
}

enum TenantFeature {
  TABLES
  KITCHEN
  DELIVERY
  MEMBERSHIPS
  ACCESS_CONTROL
  SERVICES
  APPOINTMENTS
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

// Per-tenant access state. Decoupled from the global User.status so that
// disabling a user in one tenant never affects their access elsewhere and
// historical records/audit are always preserved (no physical deletion).
enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

model Tenant {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique // subdomain / identifier
  status           TenantStatus     @default(TRIAL)
  plan             TenantPlan       @default(FREE)
  enabledModules   String[]         @default([])
  businessVertical BusinessVertical @default(RETAIL)     @map("business_vertical")
  businessProfile  BusinessProfile  @default(RETAIL)     @map("business_profile")
  posOperationMode      PosOperationMode      @default(QUICK_SALE)    @map("pos_operation_mode")
  restaurantServiceMode RestaurantServiceMode @default(TABLE_SERVICE) @map("restaurant_service_mode")
  enabledFeatures  TenantFeature[]  @default([])         @map("enabled_features")
  settings       Json? // { currency, timezone, logo, address, taxId, ... }

  // ── SaaS user-limit control ────────────────────────────────────────────────
  // overUserLimit is set on downgrade when active users exceed the new plan
  // limit. Soft enforcement: tenant keeps operating but cannot add/activate
  // more users until back under the limit. No automatic deactivation.
  overUserLimit     Boolean @default(false) @map("over_user_limit")
  // Manual cap that overrides the plan default for ANY plan (e.g. ENTERPRISE).
  userLimitOverride Int?    @map("user_limit_override")
  // Extra branches added on top of the plan default (addons, upgrades, etc.)
  extraBranchLimit  Int?    @default(0) @map("extra_branch_limit")
  // Protected owner — cannot be deactivated.
  ownerUserId       String? @map("owner_user_id")

  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships        TenantMembership[]
  customers          Customer[]
  categories         Category[]
  products           Product[]
  coupons            Coupon[]
  orders             Order[]
  orderRefunds       OrderRefund[]
  roles              Role[]
  branches           Branch[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  accountReceivables AccountReceivable[]
  accountsPayable    AccountPayable[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  services           Service[]
  serviceQuotes      ServiceQuote[]
  workOrders         WorkOrder[]
  auditLogs          AuditLog[]
  supplies           Supply[]
  supplyMovements    SupplyMovement[]
  printerConfigs     PrinterConfig[]

  usersLastSelected User[]      @relation("UserLastTenant")
  employees           Employee[]
  diningAreas         DiningArea[]
  restaurantTables    RestaurantTable[]
  diningOrders        DiningOrder[]
  dashboards          Dashboard[]
  widgets           Widget[]

  licenses          License[]
  devices           Device[]

  owner User? @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@map("tenants")
}

model TenantMembership {
  tenantId   String
  userId     String
  role       TenantRole       @default(STAFF)
  status     MembershipStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_memberships")
}

// ============= Admin Users =============
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String
  lastName  String
  role      UserRole   @default(STAFF)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenantMemberships TenantMembership[]

  // Auditoría
  customersCreated  Customer[] @relation("CustomerCreatedBy")
  customersUpdated  Customer[] @relation("CustomerUpdatedBy")
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")
  productsCreated   Product[]  @relation("ProductCreatedBy")
  productsUpdated   Product[]  @relation("ProductUpdatedBy")
  ordersCreated     Order[]    @relation("OrderCreatedBy")
  ordersUpdated     Order[]    @relation("OrderUpdatedBy")
  couponsCreated    Coupon[]   @relation("CouponCreatedBy")
  couponsUpdated    Coupon[]   @relation("CouponUpdatedBy")

  suppliersCreated Supplier[] @relation("SupplierCreatedBy")
  suppliersUpdated Supplier[] @relation("SupplierUpdatedBy")

  purchaseOrdersCreated     PurchaseOrder[]       @relation("POCreatedBy")
  purchaseOrdersUpdated     PurchaseOrder[]       @relation("POUpdatedBy")
  purchaseReceiptsReceived  PurchaseReceipt[]     @relation("ReceiptReceivedBy")
  inventoryMovementsCreated InventoryMovement[]   @relation("MovementCreatedBy")
  supplierPaymentsCreated   SupplierPayment[]     @relation("SupplierPaymentCreatedBy")
  cashMovementsCreated      CashMovement[]        @relation("CashMovementCreatedBy")
  cashSessionsOpened        CashSession[]         @relation("CashSessionOpenedBy")
  cashSessionsClosed        CashSession[]         @relation("CashSessionClosedBy")
  cashSessionsAuthorized    CashSession[]         @relation("CashSessionAuthorizedBy")
  servicesCreated           Service[]             @relation("ServiceCreatedBy")
  servicesUpdated           Service[]             @relation("ServiceUpdatedBy")
  serviceQuotesCreated      ServiceQuote[]        @relation("ServiceQuoteCreatedBy")
  ordersCancelled           Order[]               @relation("OrderCancelledBy")
  paymentsCreated           Payment[]             @relation("PaymentCreatedBy")
  refundsCreated            OrderRefund[]         @relation("RefundCreatedBy")
  auditLogs                 AuditLog[]            @relation("AuditLogUser")
  workOrdersCreated         WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrderAssignments      WorkOrderAssignment[] @relation("WorkOrderAssignments")
  employeesCreated          Employee[]         @relation("EmployeeCreatedBy")
  employeesUpdated          Employee[]         @relation("EmployeeUpdatedBy")
  diningAreasCreated        DiningArea[]       @relation("DiningAreaCreatedBy")
  diningAreasUpdated        DiningArea[]       @relation("DiningAreaUpdatedBy")
  restaurantTablesCreated   RestaurantTable[]  @relation("RestaurantTableCreatedBy")
  restaurantTablesUpdated   RestaurantTable[]  @relation("RestaurantTableUpdatedBy")
  dashboardsCreated         Dashboard[]        @relation("DashboardCreatedBy")
  dashboardsUpdated         Dashboard[]        @relation("DashboardUpdatedBy")
  widgetsCreated            Widget[]           @relation("WidgetCreatedBy")
  widgetsUpdated            Widget[]           @relation("WidgetUpdatedBy")
  suppliesCreated           Supply[]           @relation("SupplyCreatedBy")
  suppliesUpdated           Supply[]           @relation("SupplyUpdatedBy")
  supplyMovementsCreated    SupplyMovement[]   @relation("SupplyMovementCreatedBy")

  roleAssignments  UserRoleAssignment[]
  permissionGrants UserPermissionGrant[]

  refreshTokens RefreshToken[]

  managedBranches   Branch[]           @relation("BranchManager")
  branchMemberships BranchMembership[]

  lastTenantSelectedId String? @map("last_tenant_selected_id")
  lastBranchSelectedId String? @map("last_branch_selected_id")

  lastTenantSelected Tenant? @relation("UserLastTenant", fields: [lastTenantSelectedId], references: [id], onDelete: SetNull)
  lastBranchSelected Branch? @relation("UserLastBranch", fields: [lastBranchSelectedId], references: [id], onDelete: SetNull)

  tenantsOwned Tenant[] @relation("TenantOwner")

  @@map("users")
}

// ============= Customers =============
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerType {
  NEW
  REGULAR
  VIP
  WHOLESALE
}

model Customer {
  id        String         @id @default(uuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  company   String?
  city      String?
  legalName String?        @map("legal_name")
  status    CustomerStatus @default(ACTIVE)

  type        CustomerType @default(NEW)
  totalOrders Int          @default(0)
  totalSpent  Decimal      @default(0) @db.Decimal(10, 2)

  hasCredit   Boolean  @default(false)
  creditLimit Decimal? @db.Decimal(10, 2)
  creditDays  Int      @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses          CustomerAddress[]
  orders             Order[]
  accountReceivables AccountReceivable[]
  serviceQuotes      ServiceQuote[]
  workOrders         WorkOrder[]
  createdBy          User?               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String
  firstName  String
  lastName   String
  phone      String
  address1   String
  address2   String?
  city       String
  state      String
  zipCode    String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@map("customer_addresses")
}

// ============= Suppliers =============
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  contactName  String?
  email        String
  phone        String?
  city         String?
  category     String?
  paymentTerms String?
  status       SupplierStatus @default(ACTIVE)
  totalOrders  Int            @default(0)
  totalSpent   Decimal        @default(0) @db.Decimal(12, 2)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountPayable[]

  @@unique([tenantId, email])
  @@map("suppliers")
}

// ============= Purchases =============

enum PurchaseOrderStatus {
  BORRADOR
  ENVIADA
  PARCIAL
  COMPLETADA
  CANCELADA
}

enum InventoryMovementType {
  COMPRA
  VENTA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCION
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  orderNumber  String
  supplierId   String
  branchId     String?
  status       PurchaseOrderStatus @default(BORRADOR)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Decimal             @db.Decimal(10, 2)
  tax          Decimal             @default(0) @db.Decimal(10, 2)
  total        Decimal             @db.Decimal(10, 2)
  notes        String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          PurchaseOrderItem[]
  receipts       PurchaseReceipt[]
  accountPayable AccountPayable?
  createdBy      User?               @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?               @relation("POUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantityOrdered Int
  unitCost        Decimal @db.Decimal(10, 2)
  tax             Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String
  receivedById    String?
  receivedDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User?                 @relation("ReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items         PurchaseReceiptItem[]

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String @id @default(uuid())
  purchaseReceiptId String
  productId         String
  quantityReceived  Int

  receipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@map("purchase_receipt_items")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  tenantId      String
  type          InventoryMovementType
  productId     String
  branchId      String?
  quantity      Int
  referenceId   String?
  referenceType String?
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

// ============= Categories =============
enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  coupons   Coupon[]
  createdBy User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@map("categories")
}

// ============= Products =============
enum ProductType {
  SIMPLE
  RECIPE
  COMBO
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaxCode {
  IVA_16
  IVA_11
  IVA_8
  EXCENTO
}

model Product {
  id              String        @id @default(uuid())
  tenantId        String
  sku             String
  name            String
  slug            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  taxRate         Decimal?      @db.Decimal(10, 2)
  taxCode         TaxCode?      @default(IVA_16)
  comparePrice    Decimal?      @db.Decimal(10, 2)
  costPrice       Decimal?      @db.Decimal(10, 2)
  type            ProductType   @default(SIMPLE)
  categoryId      String?
  status          ProductStatus @default(DRAFT)
  stock           Int           @default(0)
  trackInventory  Boolean       @default(true)
  lowStockAlert   Int           @default(5)
  metaTitle       String?
  metaDescription String?
  lastCost        Decimal?      @db.Decimal(10, 2)
  avgCost         Decimal?      @db.Decimal(10, 2)
  // Gates visibility on the public storefront (see StoreService) and whether
  // the admin product form asks for attribute values (size/color/type/...).
  isEcommerce     Boolean       @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images               ProductImage[]
  orderItems           OrderItem[]
  coupons              Coupon[]
  branchInventory      BranchInventory[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  inventoryMovements   InventoryMovement[]
  quoteItems           ServiceQuoteItem[]
  recipe               Recipe?
  comboItems           ComboItem[]          @relation("ComboItems")
  inCombos             ComboItem[]          @relation("ComboChildItems")
  attributes           ProductAttribute[]
  createdBy            User?                @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  key       String?
  mimeType  String?  @map("mime_type")
  size      Int?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============= Product Attributes (e-commerce) =============
// Per-product line (variant/modifier): always owned by exactly one Product,
// with its own cost and price. Not a reusable cross-product catalog.
model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  name      String
  cost      Decimal  @default(0) @db.Decimal(10, 2)
  price     Decimal  @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_attributes")
}

// ============= Measurement Units =============
enum UnitCategory {
  WEIGHT
  VOLUME
  COUNT
}

model MeasurementUnit {
  id         String       @id @default(uuid())
  name       String
  symbol     String       @unique
  category   UnitCategory
  baseFactor Decimal      @default(1) @db.Decimal(15, 6)
  isBase     Boolean      @default(false)
  isSystem   Boolean      @default(true)

  baseSupplies      Supply[]           @relation("SupplyBaseUnit")
  inventorySupplies Supply[]           @relation("SupplyInventoryUnit")
  allowedInSupplies SupplyAllowedUnit[]
  recipeItems       RecipeItem[]

  @@map("measurement_units")
}

model SupplyAllowedUnit {
  id               String  @id @default(uuid())
  supplyId         String
  unitId           String
  conversionFactor Decimal @default(1) @db.Decimal(15, 6)

  supply Supply          @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  unit   MeasurementUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([supplyId, unitId])
  @@map("supply_allowed_units")
}

// ============= Supplies (Insumos/Ingredientes) =============
enum SupplyStatus {
  ACTIVE
  INACTIVE
}

enum SupplyMovementType {
  PURCHASE
  RECIPE_CONSUMPTION
  ADJUSTMENT
}

model Supply {
  id               String       @id @default(uuid())
  tenantId         String
  name             String
  sku              String
  unit             String
  purchaseUnit     String?      @map("purchase_unit")
  stock            Decimal      @default(0) @db.Decimal(15, 6)
  minStock         Decimal      @default(0) @db.Decimal(15, 6)
  cost             Decimal      @default(0) @db.Decimal(10, 2)
  baseUnitId       String?
  inventoryUnitId  String?
  conversionFactor Decimal      @default(1) @db.Decimal(15, 6)
  branchId         String?
  status           SupplyStatus @default(ACTIVE)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  baseUnit      MeasurementUnit?   @relation("SupplyBaseUnit", fields: [baseUnitId], references: [id], onDelete: SetNull)
  inventoryUnit MeasurementUnit?   @relation("SupplyInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: SetNull)
  allowedUnits  SupplyAllowedUnit[]
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation("BranchSupplies", fields: [branchId], references: [id], onDelete: SetNull)
  recipeItems   RecipeItem[]
  movements     SupplyMovement[]
  createdBy     User?              @relation("SupplyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?              @relation("SupplyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@map("supplies")
}

model SupplyMovement {
  id          String             @id @default(uuid())
  tenantId    String
  supplyId    String
  type        SupplyMovementType
  quantity    Decimal            @db.Decimal(10, 3)
  branchId    String?
  referenceId String?
  notes       String?
  createdById String?
  createdAt   DateTime           @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  branch    Branch? @relation("BranchSupplyMovements", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("SupplyMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("supply_movements")
}

// ============= Recipes & Combos =============
model Recipe {
  id        String   @id @default(uuid())
  productId String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id                 String   @id @default(uuid())
  recipeId           String
  supplyId           String
  quantity           Decimal  @db.Decimal(10, 3)
  unit               String
  unitId             String?
  normalizedQuantity Decimal? @db.Decimal(15, 6)

  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply          Supply           @relation(fields: [supplyId], references: [id])
  measurementUnit MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@map("recipe_items")
}

model ComboItem {
  id             String @id @default(uuid())
  comboProductId String
  childProductId String
  quantity       Int    @default(1)

  combo Product @relation("ComboItems", fields: [comboProductId], references: [id], onDelete: Cascade)
  child Product @relation("ComboChildItems", fields: [childProductId], references: [id])

  @@map("combo_items")
}

// ============= Coupons =============
enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  GLOBAL
  PRODUCT
  CATEGORY
}

model Coupon {
  id          String      @id @default(uuid())
  tenantId    String
  code        String
  description String?
  type        CouponType
  value       Decimal     @db.Decimal(10, 2)
  scope       CouponScope

  productId  String?
  categoryId String?

  autoApply           Boolean        @default(false)
  customerTypes       CustomerType[]
  isFirstPurchaseOnly Boolean        @default(false)
  minOrders           Int?

  minPurchase           Decimal? @db.Decimal(10, 2)
  maxDiscount           Decimal? @db.Decimal(10, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usageCount            Int      @default(0)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("CouponUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orders    Order[]

  @@unique([tenantId, code])
  @@map("coupons")
}

// ============= Services =============

model Service {
  id                String  @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  basePrice         Decimal @db.Decimal(10, 2)
  estimatedDuration String?
  hasVariablePrice  Boolean @default(false)
  isActive          Boolean @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  quoteItems ServiceQuoteItem[]
  orderItems OrderItem[]
  workOrders WorkOrder[]

  @@map("services")
}

// ============= Service Quotes =============

enum ServiceQuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model ServiceQuote {
  id                    String             @id @default(uuid())
  tenantId              String
  customerId            String
  quoteNumber           String
  status                ServiceQuoteStatus @default(DRAFT)
  estimatedDeliveryDate DateTime?
  subtotal              Decimal            @db.Decimal(10, 2)
  tax                   Decimal            @default(0) @db.Decimal(10, 2)
  total                 Decimal            @db.Decimal(10, 2)
  notes                 String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id])
  items          ServiceQuoteItem[]
  orders         Order[]
  workOrderLinks WorkOrderQuote[]
  createdBy      User?              @relation("ServiceQuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, quoteNumber])
  @@map("service_quotes")
}

model ServiceQuoteItem {
  id             String  @id @default(uuid())
  serviceQuoteId String
  itemType       String  @default("SERVICE")
  serviceId      String?
  productId      String?
  sku            String?
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  serviceQuote ServiceQuote @relation(fields: [serviceQuoteId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("service_quote_items")
}

// ============= Orders =============
enum OrderStatus {
  PENDING
  LAYAWAY
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentConcept {
  SALE
  DOWN_PAYMENT
  LAYAWAY_DEPOSIT
  BALANCE_PAYMENT
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
}

enum KitchenOrderStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  READY
  REJECTED
  DELIVERED
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

enum OrderOrigin {
  RETAIL_POS
  RESTAURANT_COMANDA
  DELIVERY
  KIOSK
  ONLINE
}

// ============= Restaurant: Dining Areas =============

model DiningArea {
  id           String  @id @default(uuid())
  tenantId     String
  branchId     String
  name         String
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("DiningAreaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("DiningAreaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tables    RestaurantTable[]

  @@unique([branchId, name])
  @@index([tenantId, branchId, isActive])
  @@map("dining_areas")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BLOCKED
}

enum DiningOrderStatus {
  OPEN
  // Kitchen flow (module KITCHEN enabled)
  SENT_TO_KITCHEN
  IN_PREPARATION
  READY
  DELIVERED
  // No-kitchen flow (module KITCHEN disabled)
  READY_FOR_PAYMENT
  // Terminal
  PAID
  CLOSED
  CANCELLED
}

enum DiningServiceType {
  DINE_IN
  COUNTER
}

enum RestaurantServiceMode {
  TABLE_SERVICE
  COUNTER_SERVICE
  HYBRID
}

// Per-branch waiter command visibility. Controls whether an operator (waiter)
// sees every active DiningOrder or only their own. Tables/Kitchen/Cashier are
// NEVER filtered by this — only DiningOrder listing for scope='own'. The filter
// itself is NOT implemented yet (see DiningOrdersService.resolveVisibilityWhere):
// today all modes behave like SHARED. Default SHARED preserves current behavior.
enum RestaurantVisibilityMode {
  SHARED
  OWN_ONLY
  OWN_WITH_SUPERVISOR
}

model RestaurantTable {
  id           String      @id @default(uuid())
  tenantId     String
  branchId     String
  areaId       String
  name         String
  capacity     Int         @default(4)
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  status       TableStatus @default(AVAILABLE)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area      DiningArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("RestaurantTableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("RestaurantTableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  diningOrders DiningOrder[]

  @@unique([branchId, name])
  @@index([tenantId, branchId, areaId, isActive])
  @@map("restaurant_tables")
}

model DiningOrder {
  id          String            @id @default(uuid())
  tenantId    String
  branchId    String
  tableId     String?
  waiterId    String
  serviceType DiningServiceType @default(DINE_IN)  @map("service_type")
  reference   String?
  status      DiningOrderStatus @default(OPEN)
  openedAt    DateTime          @default(now())
  closedAt    DateTime?

  // Financial bridge: set when the dining order is checked out and converted
  // into a financial Order. Nullable (open/operational orders have none) and
  // unique (a dining order maps to at most one Order). No lifecycle logic yet.
  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiter        Employee         @relation("DiningOrderWaiter", fields: [waiterId], references: [id])
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items         DiningOrderItem[]
  kitchenRounds KitchenRound[]

  @@index([tenantId, branchId, status])
  @@index([tableId, status])
  @@map("dining_orders")
}

enum KitchenRoundStatus {
  SENT
  IN_PREPARATION
  DONE
}

model KitchenRound {
  id          String             @id @default(uuid())
  orderId     String             @map("order_id")
  roundNumber Int                @map("round_number")
  sentAt      DateTime           @map("sent_at")
  status      KitchenRoundStatus @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order DiningOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items DiningOrderItem[]

  @@index([orderId])
  @@map("kitchen_rounds")
}

model DiningOrderItem {
  id          String      @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Decimal     @db.Decimal(10, 2)
  quantity    Int         @default(1)
  notes       String?

  // Momento en que el ítem se envió a cocina/caja. NULL = pendiente de envío
  // (ronda en captura). Permite rondas múltiples sobre la misma cuenta sin
  // duplicar DiningOrder y sin re-enviar lo ya preparado.
  sentToKitchenAt DateTime? @map("sent_to_kitchen_at")

  // FK a la ronda de cocina que lo envió. NULL para ítems pre-migración o cuando
  // kitchen está deshabilitado.
  kitchenRoundId String?       @map("kitchen_round_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        DiningOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenRound KitchenRound? @relation(fields: [kitchenRoundId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("dining_order_items")
}

model Order {
  id             String        @id @default(uuid())
  tenantId       String
  orderNumber    String
  customerId     String?
  addressId      String?
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  tableNumber    String?
  employeeNumber String?
  guestCount     Int?

  couponId   String?
  couponCode String?

  branchId String?

  exchangeRateUsed      Decimal?        @db.Decimal(10, 4)
  serviceQuoteId        String?
  deliveryStatus        DeliveryStatus?
  estimatedDeliveryDate DateTime?
  deliveredAt           DateTime?

  orderOrigin            OrderOrigin?
  kitchenStatus          KitchenOrderStatus?
  kitchenStartedAt       DateTime?
  kitchenReadyAt         DateTime?
  kitchenPausedAt        DateTime?
  kitchenRejectedAt      DateTime?
  kitchenRejectedById    String?
  kitchenRejectionComment String?

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id])
  shippingAddress   CustomerAddress?   @relation(fields: [addressId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  branch            Branch?            @relation(fields: [branchId], references: [id])
  serviceQuote      ServiceQuote?      @relation(fields: [serviceQuoteId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  accountReceivable AccountReceivable?
  refunds           OrderRefund[]
  diningOrder       DiningOrder?
  createdBy         User?              @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?              @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy       User?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  itemType    OrderItemType @default(PRODUCT)
  productId   String?
  serviceId   String?
  name        String
  description String?
  sku         String?
  quantity    Int
  price       Decimal       @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  subtotal    Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  refundItems OrderRefundItem[]

  @@map("order_items")
}

// ============= Branches =============
enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

model Branch {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  email     String?
  managerId String?
  isMain    Boolean      @default(false)
  status    BranchStatus @default(ACTIVE)
  settings  Json?

  // Waiter command visibility for this branch. Default SHARED = current behavior
  // (everyone sees every active order). Persisted infra for a future filter; not
  // enforced yet. See DiningOrdersService.resolveVisibilityWhere.
  restaurantVisibilityMode RestaurantVisibilityMode @default(SHARED) @map("restaurant_visibility_mode")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager            User?               @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  memberships        BranchMembership[]
  inventory          BranchInventory[]
  orders             Order[]
  inventoryMovements InventoryMovement[]
  cashSessions       CashSession[]
  purchaseOrders     PurchaseOrder[]
  supplies           Supply[]           @relation("BranchSupplies")
  supplyMovements    SupplyMovement[]   @relation("BranchSupplyMovements")
  printerConfigs     PrinterConfig[]
  devices            Device[]
  employeeBranches   EmployeeBranch[]
  diningAreas        DiningArea[]
  restaurantTables   RestaurantTable[]
  diningOrders       DiningOrder[]

  usersLastSelected User[] @relation("UserLastBranch")

  @@unique([tenantId, code])
  @@map("branches")
}

model BranchMembership {
  branchId   String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([branchId, userId])
  @@map("branch_memberships")
}

model BranchInventory {
  branchId  String
  productId String
  stock     Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@map("branch_inventory")
}

// ============= Payments =============
model Payment {
  id                     String         @id @default(uuid())
  orderId                String
  paymentMethod          String
  transactionId          String?
  currency               String         @default("MXN")
  amount                 Decimal        @db.Decimal(10, 2)
  amountReceived         Decimal?       @db.Decimal(10, 2)
  changeGiven            Decimal?       @db.Decimal(10, 2)
  changeCurrency         String?
  exchangeRateUsed       Decimal?       @db.Decimal(10, 4)
  amountOriginalCurrency Decimal?       @db.Decimal(10, 2)
  amountMxnEquivalent    Decimal?       @db.Decimal(10, 2)
  status                 PaymentStatus  @default(PENDING)
  paymentConcept         PaymentConcept @default(SALE)
  gatewayResponse        Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ============= Order Refunds =============
model OrderRefund {
  id               String   @id @default(uuid())
  tenantId         String
  orderId          String
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("MXN")
  refundMethod     String
  originalMethod   String?
  reason           String
  restoreInventory Boolean  @default(false)
  windowOverride   Boolean  @default(false)
  notes            String?
  cashMovementId   String?
  createdById      String?
  createdAt        DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order  @relation(fields: [orderId], references: [id])
  createdBy User?  @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderRefundItem[]

  @@index([tenantId, orderId])
  @@map("order_refunds")
}

// Per-line breakdown of an item-level refund. Its presence on a refund is what
// drives inventory restoration; money-only refunds carry no items. Cumulative
// quantity per orderItem (summed across refunds) must never exceed the quantity
// originally sold — that invariant is what stops a line being restored twice.
model OrderRefundItem {
  id          String  @id @default(uuid())
  refundId    String
  orderItemId String
  productId   String?
  quantity    Int
  createdAt   DateTime @default(now())

  refund    OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem   @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([refundId])
  @@map("order_refund_items")
}

// ============= Accounts Receivable (CxC) =============
enum AccountReceivableStatus {
  PENDIENTE
  PARCIAL
  PAGADO
  VENCIDO
}

model AccountReceivable {
  id          String                  @id @default(uuid())
  tenantId    String
  orderId     String                  @unique
  customerId  String?
  totalAmount Decimal                 @db.Decimal(10, 2)
  balance     Decimal                 @db.Decimal(10, 2)
  status      AccountReceivableStatus @default(PENDIENTE)
  dueDate     DateTime
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order                      @relation(fields: [orderId], references: [id])
  customer Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments AccountReceivablePayment[]

  @@map("account_receivables")
}

model AccountReceivablePayment {
  id                  String   @id @default(uuid())
  accountReceivableId String
  amount              Decimal  @db.Decimal(10, 2)
  paymentDate         DateTime @default(now())
  paymentMethod       String
  reference           String?
  notes               String?
  createdAt           DateTime @default(now())

  accountReceivable AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Cascade)

  @@map("account_receivable_payments")
}

// ============= Accounts Payable (CxP) =============

enum AccountPayableStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum SupplierPaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum CashSessionStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  SALE
  CXC_PAYMENT
  SUPPLIER_PAYMENT
  INCOME
  EXPENSE
}

model CashSession {
  id                 String            @id @default(uuid())
  tenantId           String
  branchId           String?
  status             CashSessionStatus @default(ABIERTA)
  exchangeRateUsdMxn Decimal           @default(1) @db.Decimal(10, 4)
  openingAmount      Decimal           @db.Decimal(10, 2)
  openingAmountUsd   Decimal           @default(0) @db.Decimal(10, 2)
  closingAmount      Decimal?          @db.Decimal(10, 2)
  cashCounted        Decimal?          @db.Decimal(10, 2)
  cashCountedUsd     Decimal?          @db.Decimal(10, 2)
  difference         Decimal?          @db.Decimal(10, 2)
  differenceUsd      Decimal?          @db.Decimal(10, 2)
  notes              String?
  openedById         String?
  closedById         String?
  authorizedById     String?
  openedAt           DateTime          @default(now())
  closedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  openedBy     User?          @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy     User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  authorizedBy User?          @relation("CashSessionAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  movements    CashMovement[]

  @@map("cash_sessions")
}

model AccountPayable {
  id              String               @id @default(uuid())
  tenantId        String
  purchaseOrderId String               @unique
  supplierId      String
  totalAmount     Decimal              @db.Decimal(10, 2)
  balance         Decimal              @db.Decimal(10, 2)
  status          AccountPayableStatus @default(PENDIENTE)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  payments      SupplierPayment[]

  @@map("accounts_payable")
}

model SupplierPayment {
  id               String                @id @default(uuid())
  accountPayableId String
  amount           Decimal               @db.Decimal(10, 2)
  paymentMethod    SupplierPaymentMethod
  paymentDate      DateTime              @default(now())
  reference        String?
  notes            String?
  createdById      String?
  createdAt        DateTime              @default(now())

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cashMovements  CashMovement[]

  @@map("supplier_payments")
}

model CashMovement {
  id                     String           @id @default(uuid())
  tenantId               String
  cashSessionId          String?
  type                   CashMovementType
  currency               String           @default("MXN")
  amount                 Decimal          @db.Decimal(10, 2)
  exchangeRateUsed       Decimal?         @db.Decimal(10, 4)
  amountOriginalCurrency Decimal?         @db.Decimal(10, 2)
  amountMxnEquivalent    Decimal?         @db.Decimal(10, 2)
  paymentMethod          String
  supplierPaymentId      String?          @unique
  referenceId            String?
  referenceType          String?
  notes                  String?
  createdById            String?
  createdAt              DateTime         @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession     CashSession?     @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("cash_movements")
}

// ============= Audit Log (critical operations) =============

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String // ORDER_CANCEL, ORDER_RETURN, INVENTORY_ADJUST, PRICE_CHANGE
  entityType String // Order, Product, ...
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ============= Permissions & Roles (tenant-scoped) =============

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  module      String
  action      String

  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]

  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean @default(false)
  color       String? @default("#6366f1")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]
  dashboardRoles  DashboardRole[]
  widgetRoles     WidgetRole[]
  employees       Employee[]           @relation("EmployeeRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId     String
  roleId     String
  tenantId   String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model UserPermissionGrant {
  userId       String
  permissionId String
  tenantId     String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_grants")
}

