{
  "name": "@orbix/root",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "turbo run dev --filter=@orbix/api --filter=@orbix/web",
    "dev:mobile": "turbo run dev --filter=@orbix/app",
    "dev:server": "turbo run dev --filter=@orbix/api",
    "dev:web": "turbo run dev --filter=@orbix/api --filter=@orbix/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "msw",
      "prisma",
      "puppeteer",
      "unrs-resolver"
    ]
  }
